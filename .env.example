# Public Supabase values. Never expose a service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required only for trusted server-side jobs; never expose this to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public URL used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
